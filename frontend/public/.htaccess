<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  DirectoryIndex index.php index.html

  # Serve /index.php with HTTP 404 status code when ErrorDocument triggers
  ErrorDocument 404 /index.php

  # 0. Dynamic Live Sitemaps from Backend (Proxy / Cache via sitemap.php)
  RewriteRule ^(sitemap\.xml|sitemap-blogs\.xml|sitemap-products\.xml|sitemap-categories\.xml|sitemap-static\.xml)$ /sitemap.php?file=$1 [L,QSA]

  # 1. Do NOT rewrite backend API requests
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 2. Serve existing physical files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Permanent 301 Redirects for Legacy / Alias Routes
  RewriteRule ^trending-now/?$ /rings [R=301,L]
  RewriteRule ^trending/?$ /rings [R=301,L]
  RewriteRule ^collections/?$ /all-collections [R=301,L]
  RewriteRule ^exchange/?$ /sell-gold [R=301,L]
  RewriteRule ^plans/gold-mine/?$ /gold-mine [R=301,L]
  RewriteRule ^buy-loose-stones/?$ /loose-stones [R=301,L]
  RewriteRule ^loose-diamonds/?$ /loose-stones [R=301,L]
  RewriteRule ^custom-pendant/?$ /custom-name-pendant [R=301,L]
  RewriteRule ^custom-pendant-prototype/?$ /custom-name-pendant [R=301,L]
  RewriteRule ^(shipping|international-shipping|payment|returns|giftcards)/?$ /delivery [R=301,L]
  RewriteRule ^blogs/?$ /blog [R=301,L]
  RewriteRule ^profile/ten-plus-one-product(/.*)?$ /gold-mine [R=301,L]

  # 4. Whitelist Homepage
  RewriteRule ^$ /index.php [L]
  RewriteRule ^index\.html$ /index.php [L]

  # 5. Whitelist Static & Informational Pages
  RewriteRule ^(about|contact|zoniraz-alwar|franchise|sell-gold|buy-gold|gold-mine|loose-stones|custom-name-pendant|all-collections|delivery|privacy|terms|cart|checkout|wishlist|profile|admin-call|wallet)/?$ /index.php [L]

  # 6. Whitelist Canonical Category Pages
  RewriteRule ^(rings|earrings|pendants|pendant|necklaces|bangles|bracelets|mangalsutras|mangalsutra|nose-pins|nose-pin|solitaires|solitaire|gold-coins|coins|chain|chains|zodiac|brooches|anklets|mens-jewellery|womens-jewellery|kids-jewellery)/?$ /index.php [L]

  # 7. Whitelist Blog Landing & Dynamic Blog Articles
  RewriteRule ^blogs?(/.*)?$ /index.php [L]

  # 8. Whitelist Dynamic Product Slugs
  RewriteRule ^product/([^/]+)/?$ /index.php [L]

  # 9. Strict Nonexistent Route Fallback: HTTP 404
  # Nonexistent URLs will NOT rewrite to /index.php with 200
  # They trigger ErrorDocument 404 (/index.php with HTTP 404 status)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>
